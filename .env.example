TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=telegram_session
# Optional: base64-encoded content of your Telethon session file (telegram_session.session)
# Helpful for non-interactive environments like Railway if you can't input the code manually.
TELEGRAM_SESSION_BASE64=
# Optional: Telethon StringSession (preferred over BASE64 for shorter secrets).
# Generate locally and set here to avoid very long env values.
TELEGRAM_STRING_SESSION=
TELEGRAM_CHANNELS=@channel1,@channel2

LLM_API_KEY=your_llm_key
LLM_MODEL_NAME=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
# Optional: temperature for LLM; leave empty to use provider default
LLM_TEMPERATURE=
# Optional: request timeout to LLM in seconds (default 60)
LLM_TIMEOUT=60

MAX_POSTS_PER_BATCH=10
HOURS_LOOKBACK=24
STATE_PATH=state.json
