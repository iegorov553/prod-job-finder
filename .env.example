# Telegram credentials
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=telegram_session
# Optional: base64-encoded content of your Telethon session file (telegram_session.session)
# Helpful for non-interactive environments like Railway if you can't input the code manually.
TELEGRAM_SESSION_BASE64=
# Optional: Telethon StringSession (preferred over BASE64 for shorter secrets).
# Generate locally and set here to avoid very long env values.
TELEGRAM_STRING_SESSION=

# LLM API credentials
LLM_API_KEY=your_llm_key
LLM_BASE_URL=https://api.openai.com/v1

# Telegram bot credentials
BOT_TOKEN=your_bot_token
ALLOW_USER_IDS=123456789

# Supabase credentials (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# All other settings (channels, LLM params, limits) are managed via Supabase.
# Use Telegram bot commands to configure them:
# /channels_add, /channels_remove - manage channels
# /llm_model, /llm_temp, /llm_timeout - LLM settings
# /llm_batch, /llm_limit, /llm_lookback - processing limits
# /prompt_set - custom system prompt
# /schedule_set - auto-run schedule
