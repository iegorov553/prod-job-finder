TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=telegram_session
# Optional: base64-encoded content of your Telethon session file (telegram_session.session)
# Helpful for non-interactive environments like Railway if you can't input the code manually.
TELEGRAM_SESSION_BASE64=
TELEGRAM_CHANNELS=@channel1,@channel2

LLM_API_KEY=your_llm_key
LLM_MODEL_NAME=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1

MAX_POSTS_PER_BATCH=10
HOURS_LOOKBACK=24
STATE_PATH=state.json
